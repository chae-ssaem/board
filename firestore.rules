rules_version = '2';

// 우리 반 칠판 — 파이어베이스 보안 규칙
// 파이어베이스 콘솔 → Firestore Database → 규칙(Rules) 탭에 통째로 붙여 넣고 '게시'를 눌러 주세요.
//
// 칠판마다 20자리 무작위 '반 열쇠(classId)'가 만들어지고, 이 열쇠를 아는 기기(칠판·QR을 찍은 폰)만
// 우리 반 자료를 읽고 쓸 수 있어요. 반 목록을 통째로 훑어보는 것은 막혀 있어요.
service cloud.firestore {
  match /databases/{database}/documents {

    match /classes/{classId} {
      // 반 열쇠를 정확히 아는 경우에만 (목록 조회 금지)
      allow get, create, update: if classId.size() >= 16;
      allow list, delete: if false;

      // 실시간 상태(호출·체크·알림판 등)
      match /state/{docId} {
        allow read, write: if classId.size() >= 16 && docId == 'live';
      }

      // 마감한 체크 명단 기록 (쓰기는 추가만)
      match /checks/{checkId} {
        allow read, create: if classId.size() >= 16;
        allow update, delete: if false;
      }
    }

    // 그 밖의 모든 곳은 막기
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
